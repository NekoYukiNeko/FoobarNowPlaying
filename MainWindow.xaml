<Window x:Class="FoobarNowPlaying.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now Playing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="180">

    <Grid Background="Transparent">
        <!-- Rounded semi-transparent background -->
        <Border Background="#AA000000" CornerRadius="10" Padding="20" Margin="10">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" >
                <TextBlock x:Name="ArtistText"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontSize="18"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
